{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "已保存到 Nox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Nox"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox에 저장됨"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans Nox"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Nox gespeichert"
          }
        }
      }
    },
    "插件已保存。打开 Nox 后会自动导入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plugin has been saved. Open Nox and it will be imported automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인이 저장되었습니다. Nox를 열면 자동으로 가져옵니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plugin a été enregistré. Ouvrez Nox pour l’importer automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Plugin wurde gespeichert. Öffne Nox, um es automatisch zu importieren."
          }
        }
      }
    },
    "导入并打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import & Open"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 및 열기"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer et ouvrir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren & öffnen"
          }
        }
      }
    },
    "保存后立即打开 Nox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and open Nox right away"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 후 Nox를 바로 엽니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer et ouvrir Nox immédiatement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern und Nox sofort öffnen"
          }
        }
      }
    },
    "仅导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Only"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기만"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer seulement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur importieren"
          }
        }
      }
    },
    "打开 Nox 时自动导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported when you open Nox"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox를 열 때 자동으로 가져옵니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importé à l’ouverture de Nox"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Öffnen von Nox importiert"
          }
        }
      }
    },
    "Nox 插件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox plugin"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox 플러그인"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin Nox"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox-Plugin"
          }
        }
      }
    },
    "无法仅导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t Import Only"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기만 할 수 없음"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Import seul impossible"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur-Import nicht möglich"
          }
        }
      }
    },
    "当前安装不支持共享存储，请使用「导入并打开」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This installation doesn’t support shared storage. Use “Import & Open” instead."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치에서는 공유 저장소를 지원하지 않습니다. ‘가져오기 및 열기’를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette installation ne prend pas en charge le stockage partagé. Utilisez « Importer et ouvrir »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Installation unterstützt keinen gemeinsamen Speicher. Verwende „Importieren & öffnen“."
          }
        }
      }
    },
    "正在打开 Nox…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Nox…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox 여는 중…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture de Nox…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox wird geöffnet…"
          }
        }
      }
    },
    "插件分享失败。请打开 Nox，在「设置 → 解析来源」中手动导入。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t share the plugin. Open Nox and import it manually under Settings → Parsing Sources."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인을 공유하지 못했습니다. Nox를 열고 설정 → 파싱 소스에서 직접 가져오세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de partager le plugin. Ouvrez Nox et importez-le manuellement dans Réglages → Sources d’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Plugin konnte nicht geteilt werden. Öffne Nox und importiere es manuell unter Einstellungen → Analysequellen."
          }
        }
      }
    },
    "无法打开 Nox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t Open Nox"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox를 열 수 없습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir Nox"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nox konnte nicht geöffnet werden"
          }
        }
      }
    },
    "未能从分享内容中读取网页链接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A web link couldn’t be read from the shared content."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 콘텐츠에서 웹 링크를 읽을 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire un lien web dans le contenu partagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im geteilten Inhalt konnte kein Weblink gefunden werden."
          }
        }
      }
    },
    "链接已复制。请打开 Nox，在地址栏中粘贴并访问。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link has been copied. Open Nox, paste it into the address bar, and go."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 복사되었습니다. Nox를 열고 주소 표시줄에 붙여넣은 후 이동하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien a été copié. Ouvrez Nox, collez-le dans la barre d’adresse, puis accédez-y."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link wurde kopiert. Öffne Nox, füge ihn in die Adressleiste ein und rufe ihn auf."
          }
        }
      }
    },
    "这个文件不是 Nox 插件。请分享 .noxplugin 插件文件，或网页链接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file isn’t a Nox plugin. Share a .noxplugin file or a web link."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Nox 플러그인이 아닙니다. .noxplugin 파일이나 웹 링크를 공유해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas un plugin Nox. Partagez un fichier .noxplugin ou un lien web."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein Nox-Plugin. Teile eine .noxplugin-Datei oder einen Weblink."
          }
        }
      }
    },
    "完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    }
  },
  "version": "1.0"
}

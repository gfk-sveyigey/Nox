      }
    },
    "暂无下载" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Downloads" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No Downloads" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun téléchargement" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다운로드 없음" } }
      }
    },
    "暂无历史" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Verlauf" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No History" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun historique" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록 없음" } }
      }
    },
    "在浏览页面解析视频后即可加入下载队列。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Analysiere ein Video im Browser, um es der Download-Warteschlange hinzuzufügen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Parse a video in the browser to add it to the download queue." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Analysez une vidéo dans le navigateur pour l'ajouter à la file de téléchargement." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "브라우저에서 동영상을 분석하면 다운로드 대기열에 추가됩니다." } }
      }
    },
    "打开过的视频页面会显示在这里。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Geöffnete Videoseiten erscheinen hier." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Video pages you open will appear here." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les pages vidéo ouvertes apparaîtront ici." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "열었던 동영상 페이지가 여기에 표시됩니다." } }
      }
    },
    "清空" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Leeren" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear" } },

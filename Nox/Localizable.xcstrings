        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지우기" } }
      }
    },
    "清空下载？" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Downloads leeren?" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear downloads?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Effacer les téléchargements ?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다운로드를 지울까요?" } }
      }
    },
    "清空历史记录？" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlauf leeren?" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear history?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Effacer l'historique ?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록을 지울까요?" } }
      }
    },
    "已完成、失败和已取消的任务将被移除，同时删除对应的本地文件与未完成的分片。此操作无法撤销。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abgeschlossene, fehlgeschlagene und abgebrochene Einträge werden entfernt, ebenso die zugehörigen lokalen Dateien und unfertigen Teile. Dies kann nicht rückgängig gemacht werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Completed, failed, and cancelled items will be removed, along with their local files and unfinished parts. This can't be undone." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les éléments terminés, échoués et annulés seront supprimés, ainsi que les fichiers locaux et les segments inachevés. Action irréversible." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료, 실패 및 취소된 항목이 제거되고 해당 로컬 파일과 미완료 조각도 삭제됩니다. 이 작업은 되돌릴 수 없습니다." } }
      }
    },
    "所有浏览历史将被删除，此操作无法撤销。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der gesamte Verlauf wird gelöscht. Dies kann nicht rückgängig gemacht werden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All browsing history will be deleted. This can't be undone." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tout l'historique sera supprimé. Action irréversible." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 기록이 삭제됩니다. 이 작업은 되돌릴 수 없습니다." } }
      }
    },
    "分享" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Teilen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Share" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Partager" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공유" } }
      }
    },
    "分享失败" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Teilen fehlgeschlagen" } },

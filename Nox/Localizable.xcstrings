      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Download-Qualität" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Download Quality" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Qualité de téléchargement" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다운로드 화질" } }

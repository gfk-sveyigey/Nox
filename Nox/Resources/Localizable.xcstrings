    "匹配顺序" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Reihenfolge" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Matching Order" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ordre de correspondance" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치 순서" } }
      }
    },
    "拖动右侧手柄调整顺序；越靠前优先级越高，通用 Sniffer 固定最后。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ziehe den Griff rechts, um die Reihenfolge zu ändern. Weiter oben bedeutet höhere Priorität; der generische Sniffer bleibt immer zuletzt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag the handle on the right to reorder. Items higher in the list have higher priority; Generic Sniffer always stays last." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Faites glisser la poignée à droite pour réorganiser. Plus un élément est haut, plus sa priorité est élevée ; le Sniffer générique reste toujours en dernier." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오른쪽 핸들을 드래그해 순서를 변경하세요. 위에 있을수록 우선순위가 높으며, 일반 Sniffer는 항상 마지막에 유지됩니다." } }
      }
    },
    "越靠前优先级越高，通用 Sniffer 固定最后。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Weiter oben bedeutet höhere Priorität. Der generische Sniffer bleibt immer zuletzt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Items higher in the list have higher priority. Generic Sniffer always stays last." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plus un élément est haut, plus sa priorité est élevée. Le Sniffer générique reste toujours en dernier." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "위에 있을수록 우선순위가 높으며, 일반 Sniffer는 항상 마지막에 유지됩니다." } }
      }
    },
    "分享的插件数据无法读取，请重新分享。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die geteilten Plugin-Daten konnten nicht gelesen werden. Bitte teile das Plugin erneut." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The shared plugin data couldn’t be read. Please share the plugin again." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les données du plugin partagé n’ont pas pu être lues. Veuillez partager à nouveau le plugin." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공유된 플러그인 데이터를 읽지 못했습니다. 플러그인을 다시 공유해 주세요." } }
      }
    },
    "同名插件按 ID 更新现有条目，不会在列表中新增重复行。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Plugins mit derselben ID aktualisieren den vorhandenen Eintrag und erzeugen keine doppelte Zeile." } },

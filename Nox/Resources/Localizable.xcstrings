        "en" : { "stringUnit" : { "state" : "translated", "value" : "Off: when sent to the background the app may be suspended and downloads will pause." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivé : en arrière-plan, l'app peut être suspendue et les téléchargements s'arrêtent." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "꺼짐: 백그라운드로 전환하면 시스템이 앱을 일시 중단해 다운로드가 멈출 수 있습니다." } }
      }
    },
    "循环播放极短静音。可能打断其他 App 正在播放的音频。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Spielt einen sehr kurzen stillen Clip in Schleife. Kann Audio aus anderen Apps unterbrechen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Loops a very short silent clip. May interrupt audio playing in other apps." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Joue en boucle un court extrait silencieux. Peut interrompre l'audio d'autres apps." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아주 짧은 무음을 반복 재생합니다. 다른 앱에서 재생 중인 오디오를 중단시킬 수 있습니다." } }
      }
    },
    "用系统画中画保活：不占用音频会话，不打断其他 App 的音频，也尽量减少与其他画中画的互相挤占。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hält die App über System-Bild-in-Bild am Leben: belegt keine Audio-Session, unterbricht kein Audio anderer Apps und minimiert Konflikte mit anderen PiP-Fenstern." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keeps the app alive via system Picture in Picture: it doesn't take over the audio session, doesn't interrupt other apps' audio, and minimizes conflicts with other PiP windows." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Maintient l'app active via l'image dans l'image du système : n'occupe pas la session audio, n'interrompt pas l'audio des autres apps et limite les conflits avec d'autres fenêtres PiP." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템 화면 속 화면으로 앱을 유지합니다. 오디오 세션을 점유하지 않고 다른 앱의 오디오를 방해하지 않으며 다른 PiP 창과의 충돌도 최소화합니다." } }
      }
    },
    "当前未保活" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Keep-Alive aktiv" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not keeping alive" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun maintien actif" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "유지 중 아님" } }

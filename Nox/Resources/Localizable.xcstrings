    "最小" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Minimal" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Minimum" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Minimal" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최소" } }
      }
    },
    "拖动到最左即最小：窗口高 0.1pt，视觉隐藏、不影响操作；越往右窗口越大。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ganz links = minimal: Fensterhöhe 0,1 pt, unsichtbar und ohne Einfluss auf die Bedienung; nach rechts wird das Fenster größer." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag to the far left for the minimum: 0.1 pt tall, visually hidden and does not affect operation; larger to the right." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Glissez tout à gauche pour le minimum : hauteur 0,1 pt, invisible et sans gêne ; vers la droite, la fenêtre grandit." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "왼쪽 끝은 최소: 높이 0.1pt로 보이지 않고 조작에 영향을 주지 않습니다. 오른쪽으로 갈수록 창이 커집니다." } }
      }
    },
    "画中画可能与其他 App 的画中画互相打断。这里选择共存保护不可用时如何处理。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Bild-in-Bild kann Bild-in-Bild-Fenster anderer Apps unterbrechen. Legen Sie hier fest, was bei fehlendem Koexistenzschutz geschehen soll." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "PiP may interrupt PiP windows from other apps. Choose what to do when coexistence protection is unavailable." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'image dans l'image peut interrompre celle des autres apps. Choisissez le comportement lorsque la protection de coexistence est indisponible." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "화면 속 화면이 다른 앱의 화면 속 화면을 중단시킬 수 있습니다. 공존 보호를 사용할 수 없을 때의 동작을 선택하세요." } }
      }
    },
    "保活模式" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keep-Alive-Modus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep-Alive Mode" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mode de maintien en activité" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "백그라운드 유지 모드" } }
      }
    },
    "跟随下载任务" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Download-Aufgaben folgen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow download tasks" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suivre les tâches de téléchargement" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다운로드 작업에 따름" } }
      }
    },
    "启动即常驻" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dauerhaft ab dem Start" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Persistent from launch" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Persistant dès le lancement" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "실행 시 상시 유지" } }
      }
    },
    "跟随下载任务：有下载任务时才保活。启动即常驻：进入前台即拉起并一直保持，直到把保活方式设为「关闭」。" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Download-Aufgaben folgen: nur aktiv, solange Downloads laufen. Dauerhaft ab dem Start: startet beim Aktivwerden der App und bleibt aktiv, bis die Keep-Alive-Methode auf „Aus“ gesetzt wird." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow download tasks: keep alive only while downloads are active. Persistent from launch: start when the app becomes active and keep running until the keep-alive method is set to Off." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suivre les tâches de téléchargement : maintien actif uniquement pendant les téléchargements. Persistant dès le lancement : démarre à l'activation de l'app et reste actif jusqu'à ce que la méthode soit réglée sur « Désactivé »." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다운로드 작업에 따름: 다운로드가 있을 때만 유지합니다. 실행 시 상시 유지: 앱이 활성화될 때 시작해 유지 방식을 「끔」으로 설정할 때까지 계속 유지합니다." } }
      }
    },

    "移除书签" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Lesezeichen entfernen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove Bookmark" } },

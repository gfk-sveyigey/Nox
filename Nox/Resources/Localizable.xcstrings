    "详细日志" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausführliche Protokolle" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Verbose logging" } },
